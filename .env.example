# Endpunkt für Anfragen (POST, JSON). Leer = Demo-Modus ohne Datenübertragung.
VITE_LEAD_ENDPOINT=

# Link zur Datenschutzerklärung im Anfrageformular (empfohlen, DSGVO).
VITE_PRIVACY_URL=

# Öffentliche Adresse des Konfigurators für den Embed-Code. Leer = aktuelle Seitenadresse.
VITE_EMBED_BASE_URL=

# Weitere Ursprünge, zu denen ?return=… zurückführen darf (Komma-getrennt), z. B. https://www.ihre-domain.de
# Der eigene Ursprung des Konfigurators ist immer erlaubt; alle anderen Adressen werden ignoriert.
VITE_RETURN_ORIGINS=
